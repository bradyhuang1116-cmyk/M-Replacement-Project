# 三菱图纸替换系统 V2 — 环境变量配置示例
# 复制本文件为 .env 后修改即可生效；config.py 启动时会自动 load_dotenv()
# 所有变量都有默认值（= 改造前的硬编码值），不配置时行为与默认完全一致
#
# §12 Phase 1 路径外部化产出 —— 后续阶段引入的 queue/watch folder/log table 配置
# 会按需追加到本文件

# ── API 服务网络 ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# 允许的 CORS 来源；"*" 全通，多个用逗号分隔，例 "http://localhost:3000,http://localhost:7860"
API_CORS_ORIGINS=*

# ── vLLM 服务地址 ────────────────────────────────────────────
VLLM_BASE_URL=http://localhost:8080/v1
VLLM_MODEL_NAME=PaddleOCR-VL-1.5-0.9B

# ── Docker 容器配置 ──────────────────────────────────────────
DOCKER_CONTAINER_NAME=paddleocr-vl-vllm
DOCKER_CONTAINER_PORT=8080
DOCKER_IMAGE=ccr-2vdh3abv-pub.cnc.bj.baidubce.com/paddlepaddle/paddleocr-genai-vllm-server:latest-nvidia-gpu

# ── 模型/字体绝对路径（容器挂载/Pillow 取字体）──────────────
# 留空使用项目内默认目录（BASE_DIR/models 与 BASE_DIR/fonts）
# 客户部署时如把模型放在共享盘可改为 UNC 路径
# VLLM_MODEL_DIR=
# VLLM_CONFIG_PATH=
# FONT_PATH=
# PDF_FONT_PATH=

# ── 输出目录结构 ─────────────────────────────────────────────
# 单次任务输出在 <output_dir>/<OUTPUT_SUBDIR>/<VLMOCR_SUBDIR or PDF_REPLACEMENT_SUBDIR>
OUTPUT_SUBDIR=OUTPUT
VLMOCR_SUBDIR=VLMOCR
PDF_REPLACEMENT_SUBDIR=PDF_Replacement
Y_BOXES_CSV_NAME=y_boxes.csv
PROCESSING_REPORT_NAME=processing_report.txt

# ── 持久化数据（队列 / 日志）─────────────────────────────────
# Docker 部署时建议改成挂载卷的路径，防止容器重建时数据丢失
DATA_DIR=data
QUEUE_DB_PATH=data/queue.db
# Worker 处理产物根目录；watch folder / 队列任务的输出都落在这里
# 结构：<WORKER_OUTPUT_DIR>/<OUTPUT_SUBDIR>/<VLMOCR_SUBDIR or PDF_REPLACEMENT_SUBDIR>/
WORKER_OUTPUT_DIR=data/processed
# Worker 空闲时的轮询间隔（秒），单线程顺序消费队列
WORKER_POLL_INTERVAL=1.5
# 单任务失败后的最大重试次数（达到上限保持 failed）
WORKER_MAX_RETRY=1

# ── Watch folder（§12 Phase 3）─────────────────────────────────
# PLM 投递入口 / 处理中 / 输出 / 失败
# 生产部署改成 PLM 同事约定的 UNC 路径（如 \\server\drawings\inbox）
WATCH_INBOX_DIR=data/watch/inbox
WATCH_PROCESSING_DIR=data/watch/processing
WATCH_OUTPUT_DIR=data/watch/output
WATCH_FAILED_DIR=data/watch/failed
# 文件稳定性窗口（秒）：连续 N 秒 size+mtime 不变才入队
WATCH_STABILITY_SECONDS=3.0
# 扫描 inbox 的间隔（秒）
WATCH_SCAN_INTERVAL=2.0

# ── 旧版预留字段（暂未被代码读取，留作下一阶段使用）────────
# UPLOAD_DIR=uploads
# OUTPUT_DIR=output
# MAX_FILE_SIZE=52428800
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
